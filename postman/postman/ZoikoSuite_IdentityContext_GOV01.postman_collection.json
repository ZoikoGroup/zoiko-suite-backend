                  "  // which net/http ignores, so this was text/plain.",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "pm.test('reports the outbox depth', () => {",
                  "  pm.expect(pm.response.json().checks).to.have.property('outbox');",
                  "});"
                ]
              }
            }
