                    "name": "Jurisdictions, first page",
                    "request": {
                        "method": "GET",
                        "url": "{{baseUrl}}/v1/jurisdictions?page_size=2&filter[type]=COUNTRY",
                        "header": [
                            {
                                "key": "X-Principal-Id",
                                "value": "{{principalId}}"
                            },
                            {
                                "key": "X-Tenant-Id",
                                "value": "{{tenantId}}"
                            },
                            {
                                "key": "X-Legal-Entity-Id",
                                "value": "{{legalEntityId}}"
                            },
                            {
                                "key": "X-Correlation-ID",
                                "value": "{{correlationId}}"
                            },
                            {
                                "key": "X-Request-Id",
                                "value": "{{$guid}}"
                            },
                            {
                                "key": "X-Source-Channel",
                                "value": "API"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{envelopeJwt}}"
                            }
                        ]
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var b = pm.response.json(); pm.collectionVariables.set('nextCursor', b.next_cursor || '');"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Jurisdictions, next page",
                    "request": {
                        "method": "GET",
                        "url": "{{baseUrl}}/v1/jurisdictions?page_size=2&filter[type]=COUNTRY&cursor={{nextCursor}}",
                        "header": [
                            {
                                "key": "X-Principal-Id",
                                "value": "{{principalId}}"
                            },
                            {
                                "key": "X-Tenant-Id",
                                "value": "{{tenantId}}"
                            },
                            {
                                "key": "X-Legal-Entity-Id",
                                "value": "{{legalEntityId}}"
                            },
                            {
                                "key": "X-Correlation-ID",
                                "value": "{{correlationId}}"
                            },
                            {
                                "key": "X-Request-Id",
                                "value": "{{$guid}}"
                            },
                            {
                                "key": "X-Source-Channel",
                                "value": "API"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{envelopeJwt}}"
                            }
                        ]
                    }
                },
                {
                    "name": "Sources, paged and filtered",
                    "request": {
                        "method": "GET",
                        "url": "{{baseUrl}}/v1/sources?page_size=20&filter[jurisdiction_id]={{jurisdictionId}}",
                        "header": [
                            {
                                "key": "X-Principal-Id",
                                "value": "{{principalId}}"
                            },
                            {
                                "key": "X-Tenant-Id",
                                "value": "{{tenantId}}"
                            },
                            {
                                "key": "X-Legal-Entity-Id",
                                "value": "{{legalEntityId}}"
                            },
                            {
                                "key": "X-Correlation-ID",
                                "value": "{{correlationId}}"
                            },
                            {
                                "key": "X-Request-Id",
                                "value": "{{$guid}}"
                            },
                            {
                                "key": "X-Source-Channel",
                                "value": "API"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{envelopeJwt}}"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "name": "05 - Concurrency (API-3)",
            "item": [
                {
                    "name": "Read a pack version (ETag)",
                    "request": {
                        "method": "GET",
                        "url": "{{baseUrl}}/v1/packs/{{packRef}}/versions/{{packVersion}}",
                        "header": [
                            {
                                "key": "X-Principal-Id",
                                "value": "{{principalId}}"
                            },
                            {
                                "key": "X-Tenant-Id",
                                "value": "{{tenantId}}"
                            },
                            {
                                "key": "X-Legal-Entity-Id",
                                "value": "{{legalEntityId}}"
                            },
                            {
                                "key": "X-Correlation-ID",
                                "value": "{{correlationId}}"
                            },
                            {
                                "key": "X-Request-Id",
                                "value": "{{$guid}}"
                            },
                            {
                                "key": "X-Source-Channel",
                                "value": "API"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{envelopeJwt}}"
                            }
                        ]
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.collectionVariables.set('etag', pm.response.headers.get('ETag') || '');"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Submit for review with If-Match",
                    "request": {
                        "method": "POST",
                        "url": "{{baseUrl}}/v1/admin/packs/{{packRef}}/versions/{{packVersion}}/submit-review",
                        "header": [
                            {
                                "key": "X-Principal-Id",
                                "value": "{{principalId}}"
                            },
                            {
                                "key": "X-Tenant-Id",
                                "value": "{{tenantId}}"
                            },
                            {
                                "key": "X-Legal-Entity-Id",
                                "value": "{{legalEntityId}}"
                            },
                            {
                                "key": "X-Correlation-ID",
                                "value": "{{correlationId}}"
                            },
                            {
                                "key": "X-Request-Id",
                                "value": "{{$guid}}"
                            },
                            {
                                "key": "X-Source-Channel",
                                "value": "API"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{envelopeJwt}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Idempotency-Key",
                                "value": "{{$guid}}"
                            },
                            {
                                "key": "If-Match",
                                "value": "{{etag}}"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "name": "06 - Asynchronous compile (API-5)",
            "item": [
                {
                    "name": "Compile asynchronously",
                    "request": {
                        "method": "POST",
                        "url": "{{baseUrl}}/v1/admin/packs/{{packRef}}/versions/{{packVersion}}/compile",
                        "header": [
                            {
                                "key": "X-Principal-Id",
                                "value": "{{principalId}}"
                            },
                            {
                                "key": "X-Tenant-Id",
                                "value": "{{tenantId}}"
                            },
                            {
                                "key": "X-Legal-Entity-Id",
                                "value": "{{legalEntityId}}"
                            },
                            {
                                "key": "X-Correlation-ID",
                                "value": "{{correlationId}}"
                            },
                            {
                                "key": "X-Request-Id",
                                "value": "{{$guid}}"
                            },
                            {
                                "key": "X-Source-Channel",
                                "value": "API"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{envelopeJwt}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Idempotency-Key",
                                "value": "{{$guid}}"
                            },
                            {
                                "key": "Prefer",
                                "value": "respond-async"
                            }
                        ]
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 202) { pm.collectionVariables.set('operationId', pm.response.json().id); }"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Poll the operation",
                    "request": {
                        "method": "GET",
                        "url": "{{baseUrl}}/v1/operations/{{operationId}}",
                        "header": [
                            {
                                "key": "X-Principal-Id",
                                "value": "{{principalId}}"
                            },
                            {
                                "key": "X-Tenant-Id",
                                "value": "{{tenantId}}"
                            },
                            {
                                "key": "X-Legal-Entity-Id",
                                "value": "{{legalEntityId}}"
                            },
                            {
                                "key": "X-Correlation-ID",
                                "value": "{{correlationId}}"
                            },
                            {
                                "key": "X-Request-Id",
                                "value": "{{$guid}}"
                            },
                            {
                                "key": "X-Source-Channel",
                                "value": "API"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{envelopeJwt}}"
                            }
                        ]
                    }
                },
                {
                    "name": "Cancel the operation (queued only)",
                    "request": {
                        "method": "POST",
                        "url": "{{baseUrl}}/v1/operations/{{operationId}}/cancel",
                        "header": [
                            {
                                "key": "X-Principal-Id",
                                "value": "{{principalId}}"
                            },
                            {
                                "key": "X-Tenant-Id",
                                "value": "{{tenantId}}"
                            },
                            {
                                "key": "X-Legal-Entity-Id",
                                "value": "{{legalEntityId}}"
                            },
                            {
                                "key": "X-Correlation-ID",
                                "value": "{{correlationId}}"
                            },
                            {
                                "key": "X-Request-Id",
                                "value": "{{$guid}}"
                            },
                            {
                                "key": "X-Source-Channel",
                                "value": "API"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{envelopeJwt}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Idempotency-Key",
                                "value": "{{$guid}}"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "name": "07 - Operations (J-10, J-16)",
            "item": [
                {
                    "name": "Parked outbox events",
                    "request": {
                        "method": "GET",
                        "url": "{{baseUrl}}/v1/admin/outbox/parked?page_size=50",
                        "header": [
                            {
                                "key": "X-Principal-Id",
                                "value": "{{principalId}}"
                            },
                            {
                                "key": "X-Tenant-Id",
                                "value": "{{tenantId}}"
                            },
                            {
                                "key": "X-Legal-Entity-Id",
                                "value": "{{legalEntityId}}"
                            },
                            {
                                "key": "X-Correlation-ID",
                                "value": "{{correlationId}}"
                            },
                            {
                                "key": "X-Request-Id",
                                "value": "{{$guid}}"
                            },
                            {
                                "key": "X-Source-Channel",
                                "value": "API"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{envelopeJwt}}"
                            }
                        ]
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var b = pm.response.json(); var i = b.items || b; if (i.length) { pm.collectionVariables.set('outboxId', i[0].outbox_id); }"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Requeue a parked event",
                    "request": {
                        "method": "POST",
                        "url": "{{baseUrl}}/v1/admin/outbox/{{outboxId}}/requeue",
                        "header": [
                            {
                                "key": "X-Principal-Id",
                                "value": "{{principalId}}"
                            },
                            {
                                "key": "X-Tenant-Id",
                                "value": "{{tenantId}}"
                            },
                            {
                                "key": "X-Legal-Entity-Id",
                                "value": "{{legalEntityId}}"
                            },
                            {
                                "key": "X-Correlation-ID",
                                "value": "{{correlationId}}"
                            },
                            {
                                "key": "X-Request-Id",
                                "value": "{{$guid}}"
                            },
                            {
                                "key": "X-Source-Channel",
                                "value": "API"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{envelopeJwt}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Idempotency-Key",
                                "value": "{{$guid}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"reason\": \"broker limit raised\",\n  \"evidence_ref\": \"INC-0000\"\n}"
                        }
                    }
                },
                {
                    "name": "Backfill entity applicability (whole tenant)",
                    "request": {
                        "method": "POST",
                        "url": "{{baseUrl}}/v1/admin/entity-applicability:backfill",
                        "header": [
                            {
                                "key": "X-Principal-Id",
                                "value": "{{principalId}}"
                            },
                            {
                                "key": "X-Tenant-Id",
                                "value": "{{tenantId}}"
                            },
                            {
                                "key": "X-Legal-Entity-Id",
                                "value": "{{legalEntityId}}"
                            },
                            {
                                "key": "X-Correlation-ID",
                                "value": "{{correlationId}}"
                            },
                            {
                                "key": "X-Request-Id",
                                "value": "{{$guid}}"
                            },
                            {
                                "key": "X-Source-Channel",
                                "value": "API"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{envelopeJwt}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Idempotency-Key",
                                "value": "{{$guid}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{}"
                        }
                    }
                },
                {
                    "name": "Entity jurisdictions after backfill",
                    "request": {
                        "method": "GET",
                        "url": "{{baseUrl}}/v1/entities/{{legalEntityId}}/jurisdictions",
                        "header": [
                            {
                                "key": "X-Principal-Id",
