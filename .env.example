# =============================================================================
# Zoiko Suite — backend environment
#
# Copy to .env and fill in the blanks:   cp .env.example .env
# .env is gitignored (see .gitignore line 1). NEVER commit the filled-in file.
#
# HOW THIS FILE IS ORGANISED
#
# One section per infrastructure provider. Docker is the provider that works
# today and its values are left FILLED IN on purpose — nothing here removes or
# replaces the compose stack. Supabase is added alongside it, blank, ready to
# fill. Further providers get their own section as they arrive; the placeholder
# sections at the bottom are stubs, not requirements.
#
# ZOIKO_DB_PROVIDER selects which set is used. Flipping it back to `docker` is
# always the way home.
#
# HOW COMPOSE READS THIS FILE
#
# The documented invocation is run from the repo root:
#
#     docker compose -f deployments/docker-compose.yml up -d --build
#
# With `-f`, Compose v2 takes its project directory from the compose file's
# folder (deployments/), so it looks for deployments/.env — NOT this file. To
# make it read this one, pass it explicitly:
#
#     docker compose --env-file .env -f deployments/docker-compose.yml up -d
#
# =============================================================================


# =============================================================================
# PROVIDER SELECTOR
# =============================================================================
# docker | supabase
ZOIKO_DB_PROVIDER=docker


# =============================================================================
# PROVIDER: DOCKER  —  works today. Do not blank these.
# =============================================================================
# These are the values docker-compose.yml already hardcodes per service. They
# are local dev credentials with no production meaning, which is why they are
# committed rather than left empty: an empty value here would break the stack
# that currently works.
#
# NOTE: this user is the Postgres SUPERUSER, and a superuser bypasses row-level
# security unconditionally. That is why all 119 RLS policies across the estate
# have never once executed. It is preserved here as-is because it is what the
# running stack does — the Supabase section below is where that gets fixed.

DOCKER_DB_HOST=postgres
DOCKER_DB_PORT=5432
DOCKER_DB_USER=postgres
DOCKER_DB_PASSWORD=postgres
DOCKER_DB_SSLMODE=disable

# Each service keeps its OWN database on Docker (63 of them). DB_NAME is set
# per-service in docker-compose.yml — accounts_payable, general_ledger, and so
# on. There is no single value to put here.


# =============================================================================
# PROVIDER: SUPABASE  —  fill these in
# =============================================================================

# --- Project identity ------------------------------------------------------
# From Supabase dashboard → Project Settings → General.
# The ref is the subdomain in your project URL, e.g. abcdefghijklmnop
SUPABASE_PROJECT_REF=
SUPABASE_REGION=

# --- API surface (PostgREST / supabase-js / Storage) -----------------------
# Project Settings → API.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# WARNING: the service-role key carries BYPASSRLS. Anything connecting with it
# is exempt from every policy in the schema — exactly as unprotected as the
# Docker superuser above. Do NOT give it to the Go services. It is here for
# admin tooling and one-off migrations only.
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings → API → JWT Settings. Needed to verify tokens whose claims
# app.current_tenant_id() reads.
SUPABASE_JWT_SECRET=

# --- Postgres connection ---------------------------------------------------
# Project Settings → Database → Connection string.
#
# HOST: direct is db.<project-ref>.supabase.co
#       pooler is aws-0-<region>.pooler.supabase.com
# PORT: 5432 = direct / session pooler.  6543 = transaction pooler.
#
#   Use 6543. The transaction pooler works with our tenant isolation —
#   set_config('app.tenant_id', $1, true) is transaction-scoped, so the setting
#   travels with the transaction that set it — and at 20 pool connections per
#   service the direct limit of roughly 60 is reached before the estate finishes
#   starting.
#
#   pgx's prepared statement cache does NOT survive the transaction pooler, so
#   it has to be turned off. That is now carried by DB_OPTIONS, set per service
#   in deployments/docker-compose.supabase.yml:
#
#       default_query_exec_mode=exec statement_cache_capacity=0
#
#   `exec` rather than `simple_protocol`: both avoid the named prepared
#   statement, but exec keeps parameters bound server-side over the extended
#   protocol, where simple_protocol interpolates them into the SQL text
#   client-side. Without either, you get "prepared statement already exists" —
#   intermittently, under concurrency, after every smoke test has passed.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=
# Supabase has ONE database and it is called `postgres`. The per-service
# separation is by SCHEMA now, not by database — see SUPABASE_DB_SEARCH_PATH.
SUPABASE_DB_NAME=
# Use zoiko_backend, NOT postgres and NOT the service-role key. It is
# NOSUPERUSER NOBYPASSRLS, which is the whole reason the policies execute.
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
# Supabase requires TLS. `require` is the minimum; `verify-full` if you ship
# the CA bundle.
SUPABASE_DB_SSLMODE=

# --- Schema routing --------------------------------------------------------
# On Docker each service had its own DATABASE. On Supabase they share one and
# are separated by SCHEMA. The schema names are identical to the old database
# names (accounts_payable, general_ledger, document_vault, …), so compose can
# pass each service its existing DB_NAME value as its schema.
#
# WIRED, for four services. config.DBConfig now carries a Schema field that
# DSN() appends as search_path, in identity-context-svc,
# tenant-entity-registry-svc, authorization-svc and governance-decision-log-svc.
# The remaining 59 still build a DSN with no search_path and would silently read
# the default schema.
#
# It is NOT set through this variable. The schema differs per service, so one
# value here could not express it — each service is given its own DB_SCHEMA in
# deployments/docker-compose.supabase.yml, which is also what selects Supabase
# in the first place. This key is left in place only so that nothing else in the
# repository still refers to it as the mechanism.
SUPABASE_DB_SEARCH_PATH=

# --- Storage (for document-vault blobs) ------------------------------------
# document-vault stores a storage_key pointer, never the bytes, so the objects
# themselves can live in a Supabase Storage bucket. Blank = keep using the
# existing local/MinIO backend.
SUPABASE_STORAGE_BUCKET=


# =============================================================================
# MANAGED REDIS  —  wired, optional
# =============================================================================
# ONE service reads these. identity-context-svc is the only Redis client in the
# estate — the signed-envelope session cache and the risk-signal cache in
# internal/session. The RedisConfig in secret-vault-integration-svc is a struct
# with no client behind it, so nothing there is affected.
#
# BLANK = keep the redis:7-alpine container in docker-compose.yml. A working
# configuration, not a fallback to apologise for — but it is one unreplicated
# container with no persistence configured, so a restart drops every cached
# envelope and every failed-login counter along with it.
#
# SET = the container is ignored. identity-svc still waits for it to go healthy
# (depends_on in compose is static and cannot be made conditional on a
# variable), so it starts and sits there holding 256m and no connections.
#
# ---- Upstash: two endpoints are offered and only one works here -------------
#
# Take the value from the console's **Redis / TCP** connect panel, the one that
# starts with a scheme:
#
#     rediss://default:<PASSWORD>@<name>-<id>.upstash.io:6379
#
# NOT the REST panel (UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN). Those
# are an HTTPS API for edge runtimes that cannot open a TCP socket. go-redis
# speaks RESP over TCP and cannot use them; an https:// value here is rejected
# at startup as a malformed REDIS_URL.
#
# The scheme is `rediss`, with TWO s. `redis://` leaves TLS off, and Upstash
# closes a cleartext connection without replying — so the failure is a five
# second timeout on the startup Ping, which reads like a network fault and is
# not one. This is the single most common way this variable is set wrong.
#
# Pick the Upstash region closest to SUPABASE_DB_HOST's region. This is a
# hot-path cache on /v1/context/resolve: a cross-continent round trip per
# lookup is slower than the Postgres query it exists to avoid.
REDIS_URL=

# ---- Discrete form — an ALTERNATIVE to REDIS_URL, never a companion --------
# Read only while REDIS_URL is empty; the moment it is set these four are not
# consulted at all. Present for deployments that inject parts separately rather
# than one string.
#
# REDIS_TLS_ENABLED must be true for any managed endpoint — same timeout as
# above otherwise. Leave all four blank to keep the compose defaults
# (redis / 6379 / no password / no TLS).
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_TLS_ENABLED=


# =============================================================================
# SHARED SECRETS  —  independent of which DB provider is selected
# =============================================================================
# READ THIS BEFORE FILLING ANYTHING BELOW.
#
# Only the FIRST TWO of the secrets below are wired to compose today. Together
# with the database block and the REDIS_* block above, they are all of the
# ${...} substitution docker-compose.yml does:
CLOSE_SIGNING_KEY=
GATEWAY_PORT=
#   CLOSE_SIGNING_KEY — signs the trial-balance evidence financial-close
#                       produces at period close. Falls back to a documented
#                       local-dev key when blank.
#   GATEWAY_PORT      — host port the gateway publishes. Falls back to 8000.
#
# Everything below is HARDCODED in docker-compose.yml and is NOT read from this
# file. Filling these in changes nothing until compose is switched to
# ${VAR:-default} form. They are listed so the real values have somewhere to
# live once that happens — not because setting them now has any effect.

# AES-256 keys for encryption at rest. Must decode to exactly 32 bytes, i.e.
# 64 hex characters — the services reject anything else at startup rather than
# padding or truncating. Compose currently pins throwaway dev values
# (0f0f0f... and 0123456789abcdef...).
DOCUMENT_VAULT_MASTER_KEY_HEX=
VAULT_MASTER_KEY_HEX=

# Gateway JWT signing. Compose currently pins
# "local-dev-jwt-signing-secret-key-32-chars-long" / "local-dev-key-1".
JWT_SIGNING_SECRET=
JWT_KEY_ID=


# =============================================================================
# SERVICE LAUNCHER  (tools/servicectl)  --  replaces Docker for the services
# =============================================================================
# THE SERVICES NO LONGER RUN IN CONTAINERS. A Go service is a static binary that
# reads its configuration from the environment and listens on a port; the only
# things Docker added around that were a build step, DNS names for
# service-to-service calls, and a per-service environment block. `go build`
# replaces the first, the launcher's registry rewrites the second to 127.0.0.1,
# and THIS FILE replaces the third.
#
# That is why the file matters more than it used to. Under compose the database
# password appeared in 46 environment blocks and the Kafka broker in 78. Now it
# appears once, here, and the launcher composes each service's environment from
# it plus the handful of values that are genuinely per-service (that service's
# Kafka topic, the peers it calls). `servicectl env <service>` prints exactly
# what a service will receive, secrets masked.
#
# ---- How to run -------------------------------------------------------------
#
#   cd tools/servicectl && go build -o ../../.servicectl/servicectl.exe .
#
#   servicectl build          one-time, compiles all 86 (a few minutes)
#   servicectl serve          the daemon the console talks to
#   servicectl status         what is up
#   servicectl ports          the port table
#   servicectl env <svc>      the environment one service would receive
#
# The console's proxy.ts asks the daemon to start whichever services the
# /admin route being visited reads, and waits for them; they are stopped again
# after ZOIKO_SERVICECTL_IDLE with nothing asking. Set ZOIKO_SERVICECTL=true in
# the FRONTEND's .env.local to turn that on.
#
# Nothing here removes the compose files. They still work, and switching back is
# still `docker compose --env-file .env -f deployments/docker-compose.yml up`.

# Which database the launcher points every service at.
#
#   docker | local  -- a Postgres reachable at DB_HOST, one DATABASE per service
#   supabase        -- the managed host, ONE database and one SCHEMA per service
#
# `supabase` DOES NOT YET WORK FOR EVERY SERVICE. 80 of the 86 have a database,
# and Supabase has only one, so per-service separation has to be by SCHEMA.
# Counted honestly, of those 80:
#
#    4  read DB_SCHEMA directly and are fully correct -- identity-context-svc,
#       tenant-entity-registry-svc, authorization-svc, governance-decision-log-svc
#   34  read a whole DATABASE_URL, which the launcher gives a search_path query
#       parameter; pgx passes it to the server, so these work too
#   42  build a DSN from the discrete DB_* variables with no search_path, and
#       would silently read the DEFAULT schema instead of their own
#
# So 38 of 80 work on Supabase today. Closing the other 42 means adding a Schema
# field to their config.go and appending search_path in DSN(), which is the same
# change the four above already carry. Under `docker`/`local` all 80 work,
# because each service gets its own database.
#
# Blank or unrecognised falls back to `docker`, which is the value that has a
# database for every service.
ZOIKO_DB_PROVIDER=

# Kafka. 78 services take a broker list; four of them refuse to start without a
# reachable one (configuration-feature-flag, governance-decision-log,
# jurisdiction-rules, secret-vault-integration). The other 74 use kafka-go
# writers, which dial on first publish, so an unreachable broker there costs a
# log line rather than a startup. Blank uses 127.0.0.1:9092.
KAFKA_BROKERS=

# Tracing. Blank disables it cleanly: the OTLP exporter never dials at
# construction, so an unset endpoint is not a startup failure.
OTEL_EXPORTER_OTLP_ENDPOINT=

# =============================================================================
# FUTURE PROVIDERS  —  stubs, add one at a time
# =============================================================================
# Left commented so nothing here is read until it is deliberately enabled.
# Uncomment a block only when that provider is actually being wired.

# --- Managed Kafka (currently local Redpanda/Kafka in compose) -------------
# KAFKA_BROKERS=
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
# KAFKA_TLS_ENABLED=

# --- Managed OpenSearch (currently local in compose) -----------------------
# OPENSEARCH_URL=
# OPENSEARCH_USERNAME=
# OPENSEARCH_PASSWORD=

# --- Object storage, if it moves off MinIO ---------------------------------
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Real notification delivery --------------------------------------------
# notification-svc currently delivers through a documented STUB adapter, so
# SENT means "accepted by the stub", not "delivered". These are what a real
# provider would need.
# NOTIFICATION_EMAIL_PROVIDER=
# NOTIFICATION_EMAIL_API_KEY=
# NOTIFICATION_EMAIL_FROM=
# NOTIFICATION_SMS_PROVIDER=
# NOTIFICATION_SMS_API_KEY=

# --- Canonical Service Input Contract (ZS-ARCH-SVC-001 v2.0 §4) ------------
# Every service parses the common request envelope and validates it against
# its own conditional-field policy (services/<svc>/internal/envelope).
#
#   write-strict  (default) refuse material state changes that are missing a
#                 mandatory field; admit reads and mark them out of contract on
#                 the response. This is where the invariants actually bite —
#                 INV-08 replay protection and INV-10 evidence-before-completion
#                 are properties of writes.
#   strict        refuse reads as well. The doctrinal end state; turn this on
#                 for a service once every one of its callers sends a full
#                 envelope.
#   observe       never refuse. Parse, propagate, log the violation and set
#                 X-Envelope-Contract: violated. A migration state, not a
#                 resting state — nothing is gated.
#
# An unrecognised value falls back to write-strict rather than to observe, so a
# typo here cannot silently disable the control.
# ZS_ENVELOPE_ENFORCEMENT=write-strict
