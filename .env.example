# =============================================================================
# Zoiko Suite — backend environment
#
# Copy to .env and fill in the blanks:   cp .env.example .env
# .env is gitignored (see .gitignore line 1). NEVER commit the filled-in file.
#
# HOW THIS FILE IS ORGANISED
#
# One section per infrastructure provider. Docker is the provider that works
# today and its values are left FILLED IN on purpose — nothing here removes or
# replaces the compose stack. Supabase is added alongside it, blank, ready to
# fill. Further providers get their own section as they arrive; the placeholder
# sections at the bottom are stubs, not requirements.
#
# ZOIKO_DB_PROVIDER selects which set is used. Flipping it back to `docker` is
# always the way home.
#
# HOW COMPOSE READS THIS FILE
#
# The documented invocation is run from the repo root:
#
#     docker compose -f deployments/docker-compose.yml up -d --build
#
# With `-f`, Compose v2 takes its project directory from the compose file's
# folder (deployments/), so it looks for deployments/.env — NOT this file. To
# make it read this one, pass it explicitly:
#
#     docker compose --env-file .env -f deployments/docker-compose.yml up -d
#
# =============================================================================


# =============================================================================
# PROVIDER SELECTOR
# =============================================================================
# docker | supabase
ZOIKO_DB_PROVIDER=docker


# =============================================================================
# PROVIDER: DOCKER  —  works today. Do not blank these.
# =============================================================================
# These are the values docker-compose.yml already hardcodes per service. They
# are local dev credentials with no production meaning, which is why they are
# committed rather than left empty: an empty value here would break the stack
# that currently works.
#
# NOTE: this user is the Postgres SUPERUSER, and a superuser bypasses row-level
# security unconditionally. That is why all 119 RLS policies across the estate
# have never once executed. It is preserved here as-is because it is what the
# running stack does — the Supabase section below is where that gets fixed.

DOCKER_DB_HOST=postgres
DOCKER_DB_PORT=5432
DOCKER_DB_USER=postgres
DOCKER_DB_PASSWORD=postgres
DOCKER_DB_SSLMODE=disable

# Each service keeps its OWN database on Docker (63 of them). DB_NAME is set
# per-service in docker-compose.yml — accounts_payable, general_ledger, and so
# on. There is no single value to put here.


# =============================================================================
# PROVIDER: SUPABASE  —  fill these in
# =============================================================================

# --- Project identity ------------------------------------------------------
# From Supabase dashboard → Project Settings → General.
# The ref is the subdomain in your project URL, e.g. abcdefghijklmnop
SUPABASE_PROJECT_REF=
SUPABASE_REGION=

# --- API surface (PostgREST / supabase-js / Storage) -----------------------
# Project Settings → API.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# WARNING: the service-role key carries BYPASSRLS. Anything connecting with it
# is exempt from every policy in the schema — exactly as unprotected as the
# Docker superuser above. Do NOT give it to the Go services. It is here for
# admin tooling and one-off migrations only.
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings → API → JWT Settings. Needed to verify tokens whose claims
# app.current_tenant_id() reads.
SUPABASE_JWT_SECRET=

# --- Postgres connection ---------------------------------------------------
# Project Settings → Database → Connection string.
#
# HOST: direct is db.<project-ref>.supabase.co
#       pooler is aws-0-<region>.pooler.supabase.com
# PORT: 5432 = direct / session pooler.  6543 = transaction pooler.
#
#   Prefer 5432 to start. The transaction pooler works with our tenant
#   isolation — set_config('app.tenant_id', $1, true) is transaction-scoped, so
#   the setting travels with the transaction that set it — but pgx's prepared
#   statement cache does not survive it. If you move to 6543, add
#   `default_query_exec_mode=simple_protocol` to the DSN or you will get
#   "prepared statement already exists" under load.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=
# Supabase has ONE database and it is called `postgres`. The per-service
# separation is by SCHEMA now, not by database — see SUPABASE_DB_SEARCH_PATH.
SUPABASE_DB_NAME=
# Use zoiko_backend, NOT postgres and NOT the service-role key. It is
# NOSUPERUSER NOBYPASSRLS, which is the whole reason the policies execute.
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
# Supabase requires TLS. `require` is the minimum; `verify-full` if you ship
# the CA bundle.
SUPABASE_DB_SSLMODE=

# --- Schema routing --------------------------------------------------------
# On Docker each service had its own DATABASE. On Supabase they share one and
# are separated by SCHEMA. The schema names are identical to the old database
# names (accounts_payable, general_ledger, document_vault, …), so compose can
# pass each service its existing DB_NAME value as its schema.
#
# NOT YET WIRED: config.DBConfig.DSN() builds
#   postgres://user:pass@host:port/name?sslmode=…
# with no search_path, and the Go stores use unqualified table names. Setting
# this key alone will not route anything until DSN() appends the search_path.
# Leave blank until that change lands.
SUPABASE_DB_SEARCH_PATH=

# --- Storage (for document-vault blobs) ------------------------------------
# document-vault stores a storage_key pointer, never the bytes, so the objects
# themselves can live in a Supabase Storage bucket. Blank = keep using the
# existing local/MinIO backend.
SUPABASE_STORAGE_BUCKET=


# =============================================================================
# SHARED SECRETS  —  independent of which DB provider is selected
# =============================================================================
# READ THIS BEFORE FILLING ANYTHING BELOW.
#
# Only the FIRST TWO are wired to compose today. docker-compose.yml uses
# ${...} substitution in exactly two places, and these are they:
CLOSE_SIGNING_KEY=
GATEWAY_PORT=
#   CLOSE_SIGNING_KEY — signs the trial-balance evidence financial-close
#                       produces at period close. Falls back to a documented
#                       local-dev key when blank.
#   GATEWAY_PORT      — host port the gateway publishes. Falls back to 8000.
#
# Everything below is HARDCODED in docker-compose.yml and is NOT read from this
# file. Filling these in changes nothing until compose is switched to
# ${VAR:-default} form. They are listed so the real values have somewhere to
# live once that happens — not because setting them now has any effect.

# AES-256 keys for encryption at rest. Must decode to exactly 32 bytes, i.e.
# 64 hex characters — the services reject anything else at startup rather than
# padding or truncating. Compose currently pins throwaway dev values
# (0f0f0f... and 0123456789abcdef...).
DOCUMENT_VAULT_MASTER_KEY_HEX=
VAULT_MASTER_KEY_HEX=

# Gateway JWT signing. Compose currently pins
# "local-dev-jwt-signing-secret-key-32-chars-long" / "local-dev-key-1".
JWT_SIGNING_SECRET=
JWT_KEY_ID=


# =============================================================================
# FUTURE PROVIDERS  —  stubs, add one at a time
# =============================================================================
# Left commented so nothing here is read until it is deliberately enabled.
# Uncomment a block only when that provider is actually being wired.

# --- Managed Kafka (currently local Redpanda/Kafka in compose) -------------
# KAFKA_BROKERS=
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
# KAFKA_TLS_ENABLED=

# --- Managed OpenSearch (currently local in compose) -----------------------
# OPENSEARCH_URL=
# OPENSEARCH_USERNAME=
# OPENSEARCH_PASSWORD=

# --- Object storage, if it moves off MinIO ---------------------------------
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Real notification delivery --------------------------------------------
# notification-svc currently delivers through a documented STUB adapter, so
# SENT means "accepted by the stub", not "delivered". These are what a real
# provider would need.
# NOTIFICATION_EMAIL_PROVIDER=
# NOTIFICATION_EMAIL_API_KEY=
# NOTIFICATION_EMAIL_FROM=
# NOTIFICATION_SMS_PROVIDER=
# NOTIFICATION_SMS_API_KEY=

# --- Canonical Service Input Contract (ZS-ARCH-SVC-001 v2.0 §4) ------------
# Every service parses the common request envelope and validates it against
# its own conditional-field policy (services/<svc>/internal/envelope).
#
#   write-strict  (default) refuse material state changes that are missing a
#                 mandatory field; admit reads and mark them out of contract on
#                 the response. This is where the invariants actually bite —
#                 INV-08 replay protection and INV-10 evidence-before-completion
#                 are properties of writes.
#   strict        refuse reads as well. The doctrinal end state; turn this on
#                 for a service once every one of its callers sends a full
#                 envelope.
#   observe       never refuse. Parse, propagate, log the violation and set
#                 X-Envelope-Contract: violated. A migration state, not a
#                 resting state — nothing is gated.
#
# An unrecognised value falls back to write-strict rather than to observe, so a
# typo here cannot silently disable the control.
# ZS_ENVELOPE_ENFORCEMENT=write-strict
