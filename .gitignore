# Environment files. `.env` on its own does NOT match `.env.local` or
# `.env.production` — a gitignore pattern with no wildcard matches that exact
# name only — so the variants are listed explicitly. Getting this wrong commits
# live database credentials, and rewriting history is the only way back.
#
# `.env.example` is negated because it is the template: committed on purpose,
# blank on purpose.
.env
.env.local
.env.production
.env.*.local
!.env.example

*.pem

# secret-vault-integration-svc's local dev vault store — never commit
# encrypted-at-rest dev secret material, same spirit as *.pem above
services/*/secret_store.local

# stray compiled binaries from `go build` without -o (package-named
# binaries left in a service's own root directory)
services/*/server
services/*/healthcheck

# same, for the Supabase bootstrap tool. `go build ./...` inside its directory
# drops a ~13 MB binary named after the module, which is a build artifact and
# not a deliverable — the tool is run with `go run .`.
deployments/supabase/supabase-bootstrap
deployments/supabase/supabase-bootstrap.exe
