# Copy to deployments/.env.public-ai and fill in the values. NEVER commit the
# filled file: it contains a database password and the release verification key.
#
#   Copy-Item deployments/.env.public-ai.example deployments/.env.public-ai
#   # edit deployments/.env.public-ai
#   docker compose -f deployments/docker-compose.public-ai.yml --env-file deployments/.env.public-ai up -d --build

# Required by the compose Postgres service.
PUBLIC_AI_DB_PASSWORD=CHANGE_ME

# dev, test, staging or production. Outside dev/test the service also needs a
# policy digest and a Host allowlist, and may not use the mock model provider.
PUBLIC_AI_ENVIRONMENT=dev
PUBLIC_AI_ENABLED=true

# Required outside dev/test. Leave blank only for local dev/test.
PUBLIC_AI_POLICY_DIGEST=
PUBLIC_AI_ALLOWED_HOSTS=

# The first-party console origin that may call the public API.
PUBLIC_AI_ALLOWED_ORIGINS=http://localhost:3000

# Required: the Ed25519 public key used to verify signed releases. Generate the
# pair locally with `go run ./cmd/kbctl keygen`; keep the private key offline.
PUBLIC_AI_SIGNING_PUBLIC_KEY=CHANGE_ME_BASE64_PUBLIC_KEY

# Optional. Empty means events go to the log instead of Kafka.
PUBLIC_AI_KAFKA_BROKERS=

# Directory holding kb.release.json / claims.release.json for /releases.
PUBLIC_AI_RELEASES_DIR=./public-ai-releases

# Optional build metadata recorded in the release manifest.
GIT_SHA=unknown
