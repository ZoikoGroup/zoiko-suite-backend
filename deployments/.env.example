# Copy to `.env` in this directory and set real values. Docker Compose reads
# `.env` from the directory it runs in automatically; nothing else has to be
# passed on the command line.
#
# Every variable below has a working local default baked into
# docker-compose.yml, so a dev stack comes up with no .env at all. That is the
# point of the defaults and also their limit: they are the same well-known
# credentials in every checkout, so they are fine for a laptop and must not be
# what a deployed environment runs on. Setting them here is what makes the
# compose file free of hardcoded credentials.

# ── Postgres superuser ────────────────────────────────────────────────────────
# Owns every table, runs every migration, and creates the per-service
# application roles. Services should NOT connect as this once the app roles are
# in use (see scripts/create-app-roles.sh).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── Per-service database credentials ──────────────────────────────────────────
# DB_USER is deliberately NOT set here. Each service names its own role in
# docker-compose.yml, because the whole value of the app roles is that they
# differ per service — one shared value here would undo it. DB_PASSWORD is
# shared only because the local roles are all created with one password by
# scripts/create-app-roles.sh (APP_DB_PASSWORD); a real deployment gives each
# service its own secret and this variable goes away.
DB_PASSWORD=postgres

# Password the application roles are CREATED with, when
# scripts/create-app-roles.sh runs. Must match DB_PASSWORD above, or the
# services will authenticate against a password that was never set.
APP_DB_PASSWORD=postgres
