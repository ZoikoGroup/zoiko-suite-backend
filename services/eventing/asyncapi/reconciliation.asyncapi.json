        "summary": "Job: resolution-recommended.",
        "title": "job resolution-recommended",
        "x-zoiko-event-type": "com.zoikosuite.reconciliation.job.resolution-recommended",
        "x-zoiko-origin": "extension"
      },
      "job.unmatched-flagged": {
        "contentType": "application/json",
        "description": "Producer: Reconciliation Intelligence Service. Primary consumers / intent: Not yet declared (extension observed in the producer; register consumers per section 23). Family: Reconciliation (extension). Origin: extension (emitted by a service, not listed in section 19).",
        "name": "com.zoikosuite.reconciliation.job.unmatched-flagged",
