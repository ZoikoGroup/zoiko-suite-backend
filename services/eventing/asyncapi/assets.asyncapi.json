      "description": "Producer(s): Fixed Assets. Only the owning domain may publish (ZS-EVENT-001 E-02).",
      "messages": [
        {
          "$ref": "#/channels/asset/messages/disposed"
        },
        {
          "$ref": "#/channels/asset/messages/impaired"
        },
        {
          "$ref": "#/channels/asset/messages/revalued"
        }
      ],
      "summary": "Publish asset facts after the authoritative commit (transactional outbox)."
    },
    "publish.depreciation": {
