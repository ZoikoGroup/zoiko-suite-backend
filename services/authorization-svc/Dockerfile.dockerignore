# Used by BuildKit for builds with -f services/authorization-svc/Dockerfile.
# The context is the repository root (see the Dockerfile), so everything is
# excluded except the modules the image is built from.
*
!services/authorization-svc/
!services/identity-envelope/

# Not needed inside the image.
services/authorization-svc/.gotmp/
services/authorization-svc/**/*.exe
services/authorization-svc/**/*_test.go
services/authorization-svc/deployments/
services/identity-envelope/**/*_test.go
