# public-ai-svc (Suivo R0) — example configuration. NO REAL VALUES.
# Numeric limits are dev defaults pending DEC-07 / DEC-08 / D06-05.
PUBLIC_AI_ENABLED=false
# dev/test/staging/production. Outside dev/test: no mock model, retention must be set.
PUBLIC_AI_ENVIRONMENT=dev
# Unset = 127.0.0.1:8001 in dev, :8080 otherwise (containers set it explicitly).
PUBLIC_AI_HTTP_ADDR=127.0.0.1:8001
PUBLIC_AI_DATABASE_URL=postgres://public_ai_app:CHANGE_ME@localhost:5432/public_ai?sslmode=disable
PUBLIC_AI_KAFKA_BROKERS=
PUBLIC_AI_ALLOWED_ORIGINS=http://localhost:3000
# Model provider: mock (deterministic, dev/test only) or groq.
MODEL_PROVIDER=mock
# Groq (server-side only; never in the frontend; never commit a real key).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Model ids the service may use; GROQ_MODEL must be one of them.
PUBLIC_AI_ALLOWED_MODEL_IDS=mock-extractive-v1,openai/gpt-oss-120b
# Local dev dataset: public-kb (data/public-kb articles + synthetic claims), seed
# (data/seed, synthetic) or fixtures (testdata/fixtures).
PUBLIC_AI_DATASET=public-kb
# Dev only: serve DRAFT_PENDING_REVIEW articles, labelled "Draft content". Refused
# outside dev/test; production content needs two-person approval.
KB_ALLOW_DRAFT=true
# Dev/test only: publish and activate the dataset into Postgres on start.
PUBLIC_AI_SEED_ON_START=false
PUBLIC_AI_POLICY_VERSION=pub-policy-1.0
PUBLIC_AI_TOKEN_BUDGET_PER_TURN=2000
PUBLIC_AI_MAX_ACTIVE_TURNS_PER_SESSION=1
PUBLIC_AI_SESSION_TTL=30m
PUBLIC_AI_IDEMPOTENCY_TTL=24h
# Purge expired/deleted sessions and their turns after this long. Outside dev/test this
# MUST come from the signed retention policy (DEC-06): [period from signed policy].
PUBLIC_AI_RETENTION=
PUBLIC_AI_MAX_BODY_BYTES=16384
# gpt-oss reasons before answering: allow more than the mock needs (e.g. 15s for groq).
PUBLIC_AI_MODEL_TIMEOUT=6s
PUBLIC_AI_RATE_LIMIT_IP_PER_MIN=60
PUBLIC_AI_RATE_LIMIT_SESSION_PER_MIN=20
# Proxies whose X-Forwarded-For is believed for the per-IP limit (CIDRs). The console's
# same-origin proxy runs on loopback in dev; add the edge/LB ranges in each environment.
PUBLIC_AI_TRUSTED_PROXIES=127.0.0.1/32,::1/128
PUBLIC_AI_DAILY_TOKEN_CEILING=2000000
PUBLIC_AI_MONTHLY_TOKEN_CEILING=40000000
# Must stay false in R0; the service refuses to start otherwise.
PUBLIC_AI_LOG_RAW_PROMPT=false
PUBLIC_AI_PRODUCTION_CHAT_PII_CAPTURE=false
PUBLIC_AI_REGION=
# Ed25519 keys, base64. Generate locally with: go run ./cmd/kbctl keygen
PUBLIC_AI_SIGNING_PUBLIC_KEY=
PUBLIC_AI_SIGNING_KEY=

# OpenTelemetry traces (Doc 08 §14). Off unless an endpoint is set. Spans carry ids, enums,
# counts and token usage only; an exporter allowlist drops anything else (no prompts or answers).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=public-ai-svc
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1
