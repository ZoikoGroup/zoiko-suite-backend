{
  "$id": "https://schemas.zoikosuite.com/public-ai/SessionResponse.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "capabilities": {
      "$ref": "Capabilities.v1.schema.json"
    },
    "expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "policy_version": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0"
    },
    "session_grant": {
      "description": "Opaque short-lived bearer grant. Never log it.",
      "type": "string"
    },
    "session_id": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "session_id",
    "session_grant",
    "expires_at",
    "policy_version",
    "capabilities"
  ],
  "type": "object"
}
