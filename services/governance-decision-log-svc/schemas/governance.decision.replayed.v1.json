{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "governance.decision.replayed",
  "description": "Envelope published by governance-decision-log-svc on zoiko.governance.events when a replay manifest is recorded. The same envelope is published under the wire name governance.decision.replayed and the Event Catalogue name com.zoikosuite.governance.decision.replayed (group decision C3, rule R9); the alias carries alias_of_event_id.",
  "type": "object",
  "required": ["event_id", "event_type", "event_version", "emitted_at", "schema_version", "source_service", "tenant_id", "correlation_id", "aggregate_type", "aggregate_id", "retention_class", "payload_hash", "payload"],
  "properties": {
    "event_id": {"type": "string"},
    "event_type": {"type": "string", "enum": ["governance.decision.replayed", "com.zoikosuite.governance.decision.replayed"]},
    "event_version": {"type": "string"},
    "emitted_at": {"type": "string", "format": "date-time"},
    "schema_version": {"type": "string"},
    "source_service": {"type": "string", "enum": ["governance-decision-log-svc"]},
    "tenant_id": {"type": "string"},
    "legal_entity_id": {"type": "string"},
    "actor_id": {"type": "string"},
    "correlation_id": {"type": "string"},
    "jurisdiction_context": {"type": "string"},
    "causation_id": {"type": "string"},
    "workflow_instance_id": {"type": "string"},
    "aggregate_type": {"type": "string", "enum": ["GovernanceDecision"]},
    "aggregate_id": {"type": "string"},
    "retention_class": {"type": "string", "enum": ["EV-REGULATED"]},
    "alias_of_event_id": {"type": "string"},
    "payload_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "payload": {
      "type": "object",
      "required": ["replay_manifest_id", "decision_id", "tenant_id", "policy_version_id", "original_outcome", "replayed_outcome", "outcomes_match", "replayed_by_principal_id", "replayed_at"],
      "properties": {
        "replay_manifest_id": {"type": "string"},
        "decision_id": {"type": "string"},
        "tenant_id": {"type": "string"},
        "policy_version_id": {"type": "string"},
        "original_outcome": {"type": "string"},
        "replayed_outcome": {"type": "string"},
        "outcomes_match": {"type": "boolean"},
        "replayed_by_principal_id": {"type": "string"},
        "replayed_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
