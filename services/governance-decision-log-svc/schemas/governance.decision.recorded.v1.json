{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "governance.decision.recorded",
  "description": "Envelope published by governance-decision-log-svc on zoiko.governance.events when a decision is recorded. The same envelope is published under the wire name governance.decision.recorded and the Event Catalogue name com.zoikosuite.governance.decision.recorded (group decision C3, rule R9); the alias carries alias_of_event_id. Properties with no type are string-or-null (marked nullable for OpenAPI 3.0 validators).",
  "type": "object",
  "required": ["event_id", "event_type", "event_version", "emitted_at", "schema_version", "source_service", "tenant_id", "correlation_id", "aggregate_type", "aggregate_id", "retention_class", "payload_hash", "payload"],
  "properties": {
    "event_id": {"type": "string"},
    "event_type": {"type": "string", "enum": ["governance.decision.recorded", "com.zoikosuite.governance.decision.recorded"]},
    "event_version": {"type": "string"},
    "emitted_at": {"type": "string", "format": "date-time"},
    "schema_version": {"type": "string"},
    "source_service": {"type": "string", "enum": ["governance-decision-log-svc"]},
    "tenant_id": {"type": "string"},
    "legal_entity_id": {"type": "string"},
    "actor_id": {"type": "string"},
    "correlation_id": {"type": "string"},
    "jurisdiction_context": {"type": "string"},
    "causation_id": {"type": "string"},
    "workflow_instance_id": {"type": "string"},
    "aggregate_type": {"type": "string", "enum": ["GovernanceDecision"]},
    "aggregate_id": {"type": "string"},
    "retention_class": {"type": "string", "enum": ["EV-REGULATED"]},
    "alias_of_event_id": {"type": "string"},
    "payload_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "payload": {
      "type": "object",
      "required": ["decision_id", "tenant_id", "legal_entity_id", "actor_id", "action_type", "outcome", "rule_basis", "correlation_id", "decided_at", "domain", "chain_seq", "curr_hash", "display_ref"],
      "properties": {
        "decision_id": {"type": "string"},
        "tenant_id": {"type": "string"},
        "legal_entity_id": {"type": "string"},
        "actor_id": {"type": "string"},
        "action_type": {"type": "string"},
        "outcome": {"type": "string"},
        "rule_basis": {"type": "string"},
        "jurisdiction_context": {"description": "string or null", "nullable": true},
        "policy_version_id": {"description": "string or null", "nullable": true},
        "action_subject_type": {"description": "string or null", "nullable": true},
        "action_subject_id": {"description": "string or null", "nullable": true},
        "workflow_instance_id": {"description": "string or null", "nullable": true},
        "causation_id": {"description": "string or null", "nullable": true},
        "correlation_id": {"type": "string"},
        "decided_at": {"type": "string", "format": "date-time"},
        "title": {"description": "string or null", "nullable": true},
        "domain": {"type": "string"},
        "priority": {"description": "LOW, MEDIUM, HIGH, CRITICAL or null", "nullable": true},
        "tags": {"description": "array of strings or null", "nullable": true},
        "related_obligation_id": {"description": "string or null", "nullable": true},
        "chain_seq": {"type": "integer"},
        "curr_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "display_ref": {"type": "string"}
      }
    }
  }
}
